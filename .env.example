# ==========================================
# GMAIL SMTP CONFIGURATION (.env.example)
# ==========================================

# Your Gmail address used to authenticate SMTP
GMAIL_USER=your_email@gmail.com

# 16-character Google App Password (generated from Google Account > Security > App Passwords)
GMAIL_APP_PASSWORD=your_16_character_app_password

# Comma-separated list of recipient emails where portfolio inquiries will be delivered
CONTACT_RECEIVER=receiver1@gmail.com,receiver2@gmail.com

# Allowed CORS Origins (comma-separated or * for development)
ALLOWED_ORIGIN=http://localhost:6000,http://127.0.0.1:6000

# Backend Express Port
PORT=4000

# Optional: enable automated receipt confirmation to visitor
AUTO_REPLY_ENABLED=false
